# ============================================================
# Bugzilla RAG — configuration template
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is gitignored and never committed.
# ============================================================

# ── Bugzilla connection ───────────────────────────────────────
# REST API base URL (change for other Bugzilla instances)
BUGZILLA_BASE_URL=https://bugzilla.suse.com/rest/bug

# API keys for downloading bug reports (comma-separated, no spaces).
# Obtain from your Bugzilla profile page.
# Multiple keys are rotated automatically on rate-limit hits.
# Leave empty if you are not running the downloader.
BUGZILLA_API_KEYS=

# ── Data paths ────────────────────────────────────────────────
# Path to the JSONL bug data file (used by downloader and indexer).
BUGZILLA_JSONL=data/bug_reports.jsonl

# Path to the ChromaDB vector store directory.
CHROMA_DIR=chroma_db/

# ── Embedding model ───────────────────────────────────────────
# Must match between index time and query time.
# The model is downloaded automatically on first use (or baked
# into the Docker image at build time).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── LLM via Ollama ───────────────────────────────────────────
# Model name as shown by `ollama list`.
OLLAMA_MODEL=qwen3-coder:30b

# Ollama API endpoint.
# IMPORTANT (Docker): do NOT change this when running via Docker Compose.
# The default `http://ollama:11434` is correct inside the Compose network.
# Only change this when running WITHOUT Docker (bare-metal / venv).
OLLAMA_BASE_URL=http://localhost:11434

# LLM temperature (0.0 = deterministic, 1.0 = creative).
OLLAMA_TEMPERATURE=0.1

# ── RAG parameters ────────────────────────────────────────────
# Number of source chunks retrieved per query.
RAG_TOP_K=3

# Batch size for the indexer (bugs written per ChromaDB flush).
INDEX_BATCH_SIZE=200
